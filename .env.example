# App
APP_BASE_URL=https://booking.example.com
SESSION_SECRET=change-this-to-a-long-random-secret

# Database
DATABASE_URL=postgres://booking_user:booking_password@localhost:5432/meeting_room_booking

# LINE WORKS OAuth / SSO
LINE_WORKS_CLIENT_ID=
LINE_WORKS_CLIENT_SECRET=
LINE_WORKS_DOMAIN=coolbe.com.tw
LINE_WORKS_REDIRECT_URI=https://booking.example.com/auth/line-works/callback
LINE_WORKS_AUTHORIZATION_URL=https://auth.worksmobile.com/oauth2/v2.0/authorize
LINE_WORKS_TOKEN_URL=https://auth.worksmobile.com/oauth2/v2.0/token
LINE_WORKS_USERINFO_URL=https://auth.worksmobile.com/oauth2/v2.0/userinfo

# LINE WORKS Bot
LINE_WORKS_BOT_ID=
LINE_WORKS_SERVICE_ACCOUNT_ID=
LINE_WORKS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
LINE_WORKS_PRIVATE_KEY_PATH=./private/lineworks-private.key
LINE_WORKS_BOT_SCOPE=bot.message
LINE_WORKS_BOT_ACCESS_TOKEN=

# Notification targets
LINE_WORKS_ADMIN_CHANNEL_ID=
